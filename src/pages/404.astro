---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <div class="contenedor">
    <div class="seccion">
      <h1>Esta página no existe</h1>
      <p class="suave">Puede que el enlace esté mal o que la salida o ruta ya no esté publicada.</p>
      <div class="acciones">
        <a class="boton" href="/">Volver al inicio</a>
        <a class="boton secundario" href="/salidas/">Ver salidas</a>
      </div>
    </div>
  </div>
</Base>
