---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaSalida from '../../components/TarjetaSalida.astro';
import { DEPORTES } from '../../config';
import type { Deporte } from '../../config';
import { pasadas, proximas } from '../../lib/utils';

// Genera las dos páginas: /bici/ y /correr/
export function getStaticPaths() {
  return [{ params: { deporte: 'bici' } }, { params: { deporte: 'correr' } }];
}

const deporte = Astro.params.deporte as Deporte;
const dep = DEPORTES[deporte];

const textos: Record<Deporte, { titulo: string; texto: string }> = {
  bici: {
    titulo: 'Salidas en bici',
    texto: 'Carretera, gravel y paseo. Cada salida tiene su ficha con distancia, desnivel, punto de encuentro y, cuando hay GPX, mapa y perfil.',
  },
  correr: {
    titulo: 'Quedadas para correr',
    texto: 'Quedadas para correr con ritmo tranquilo y abiertas a todo el mundo. Cada una con su día, hora y lugar de encuentro.',
  },
};

const salidas = (await getCollection('salidas')).filter((s) => s.data.deporte === deporte);
const siguientes = proximas(salidas);
const anteriores = pasadas(salidas);
---

<Base titulo={`${dep.emoji} ${dep.nombre}`} descripcion={textos[deporte].texto} deporte={deporte}>
  <section class={`hero hero-deporte ${deporte}`}>
    <div class="contenedor">
      <h1>{dep.emoji} {textos[deporte].titulo}</h1>
      <p>{textos[deporte].texto}</p>
    </div>
  </section>

  <div class="contenedor">
    <section class="seccion">
      <h2>Próximas salidas</h2>
      {
        siguientes.length > 0 ? (
          <div class="rejilla">{siguientes.map((s) => <TarjetaSalida salida={s} />)}</div>
        ) : (
          <div class="vacio">No hay salidas programadas por ahora.</div>
        )
      }
    </section>

    {
      anteriores.length > 0 && (
        <section class="seccion" style="padding-top:0">
          <h2>Salidas anteriores</h2>
          <div class="rejilla">{anteriores.map((s) => <TarjetaSalida salida={s} />)}</div>
        </section>
      )
    }
  </div>
</Base>
