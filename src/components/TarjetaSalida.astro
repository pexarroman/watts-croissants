---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { DEPORTES } from '../config';
import { capitalizar, fechaEfectiva, formatoFecha, fotosDeSalida, textoRepeticion } from '../lib/utils';

interface Props {
  salida: CollectionEntry<'salidas'>;
}
const { salida } = Astro.props;
const d = salida.data;
const dep = DEPORTES[d.deporte];
const fotos = fotosDeSalida(salida.id);
const img = fotos[0] ? await getImage({ src: fotos[0], width: 640, height: 427, format: 'webp' }) : null;
const repite = textoRepeticion(salida);
---

<article class="tarjeta" data-deporte={d.deporte}>
  <a class="enlace-tarjeta" href={`/salidas/${salida.id}/`}>
    {img && (
      <div class="imagen">
        <img src={img.src} width={img.attributes.width} height={img.attributes.height} alt="" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="cuerpo">
      <div class="etiquetas">
        <span class="etiqueta deporte">{dep.emoji} {dep.nombre}</span>
        {repite && <span class="etiqueta repite">{repite}</span>}
      </div>
      <p class="fecha">{capitalizar(formatoFecha(fechaEfectiva(salida)))} · {d.hora}</p>
      <h3>{d.titulo}</h3>
      <p class="suave">{d.resumen}</p>
      <p class="meta">
        📍 {d.puntoEncuentro}
        {fotos.length > 0 && <> · {fotos.length} fotos</>}
      </p>
    </div>
  </a>
</article>
